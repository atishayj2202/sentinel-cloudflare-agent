# ==============================================================================
# Sentinel Configuration & API Key Inventory
# ==============================================================================

# 1. Primary LLM Provider (Google Gemini API)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# 2. Cloudflare Workers AI (Optional direct connection)
# https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.3-70b-instruct

# 3. GitHub Token for MCP / Tool Actions (Optional for live repo writes)
# https://github.com/settings/tokens (repo scope)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_REPO=atishayj2202/sentinel

# 4. Secondary Fallbacks (Optional)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# 5. Sentinel Server & Runtime Config
HOST=0.0.0.0
PORT=8787
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
