{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sentinel-agent",
  "main": "sentinel/server.py",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "python_workers"
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "frontend",
    "binding": "ASSETS"
  }
}
